# Canonical website URL used for sitemap/canonical tags.
SITE_URL=https://aifabriek.be

# Public endpoint that receives lead form submissions.
# Example: https://hooks.zapier.com/hooks/catch/123/abc
PUBLIC_LEAD_FORM_ENDPOINT=

# Optional hidden form value for source attribution.
PUBLIC_LEAD_SOURCE=aifabriek-website

# Optional source attribution override specifically for /resources opt-ins.
PUBLIC_RESOURCES_LEAD_SOURCE=resources-lead-magnet

# Optional GA4 Measurement ID (example: G-XXXXXXXXXX).
# Keep empty to disable analytics script injection.
PUBLIC_GA4_MEASUREMENT_ID=

# Set to true only when you explicitly want analytics during `npm run dev`.
PUBLIC_ENABLE_ANALYTICS_IN_DEV=false
