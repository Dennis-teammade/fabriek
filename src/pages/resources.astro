---
import BaseLayout from "../layouts/BaseLayout.astro";

const endpoint = import.meta.env.PUBLIC_LEAD_FORM_ENDPOINT || "";
const source = import.meta.env.PUBLIC_RESOURCES_LEAD_SOURCE || "resources-lead-magnet";
const hasEndpoint = Boolean(endpoint);
---
<BaseLayout title="Resources" description="Praktische checklists en frameworks voor AI-uitrol in KMO-context.">
  <section class="card lead-magnet">
    <h1>Download de AI Ops Intake Blueprint (30 dagen)</h1>
    <p>
      Een compacte starterkit voor KMO-teams die AI-initiatieven willen prioriteren zonder ruis.
      Laat je zakelijke e-mail achter en ontvang meteen de checklist en intake-template.
    </p>

    <div class="magnet-meta">
      <p><strong>Voor wie</strong> Operations leads, sales managers en zaakvoerders in KMO's.</p>
      <p><strong>Wat je krijgt</strong></p>
      <ul>
        <li>Een prioriteringskader voor AI use cases in de eerste 30 dagen</li>
        <li>Intakevragen om bottlenecks objectief te scoren</li>
        <li>Een actieformat dat je meteen met je team kan delen</li>
      </ul>
    </div>

    <form
      method="post"
      action={hasEndpoint ? endpoint : "#"}
      data-lead-form
      data-has-endpoint={String(hasEndpoint)}
    >
      <label>
        Voornaam
        <input name="name" required autocomplete="given-name" />
      </label>

      <label>
        Zakelijke e-mail
        <input type="email" name="email" required autocomplete="email" />
      </label>

      <label>
        Bedrijf
        <input name="company" autocomplete="organization" />
      </label>

      <input type="hidden" name="source" value={source} />
      <input type="hidden" name="lead_magnet" value="ai-ops-intake-blueprint" />
      <input type="hidden" name="conversion_page" value="/resources" />

      <div class="cta-row">
        <button type="submit" class="btn">Stuur me de blueprint</button>
        <a class="btn-secondary" href="/contact">Liever meteen advies?</a>
      </div>

      <p class="microcopy">Geen spam. Alleen de blueprint en gerichte opvolging als je daarom vraagt.</p>
    </form>

    <p class="note" data-no-endpoint-warning={!hasEndpoint} hidden={hasEndpoint}>
      Form endpoint ontbreekt. Stel <code>PUBLIC_LEAD_FORM_ENDPOINT</code> in om directe CRM/webhook routing te activeren.
    </p>

    <div class="confirmation" data-lead-confirmation hidden>
      <h2>Gelukt. Je aanvraag is ontvangen.</h2>
      <p>Controleer je inbox. Je ontvangt de AI Ops Intake Blueprint binnen enkele minuten.</p>
    </div>
  </section>

  <script>
    const form = document.querySelector("form[data-lead-form]");
    const confirmation = document.querySelector("[data-lead-confirmation]");
    const fallbackNote = document.querySelector("[data-no-endpoint-warning]");

    if (form) {
      const hasEndpoint = form.getAttribute("data-has-endpoint") === "true";

      if (!hasEndpoint) {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (fallbackNote) {
            fallbackNote.hidden = false;
          }
        });
      } else {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const submitter = event.submitter;
          if (submitter instanceof HTMLButtonElement) {
            submitter.disabled = true;
          }

          if (typeof window.__aifTrack === "function") {
            window.__aifTrack("resources_optin_submit", {
              page_path: window.location.pathname,
              form_id: "resources_lead_magnet",
            });
          }

          try {
            const response = await fetch(form.action, {
              method: "POST",
              body: new FormData(form),
              mode: "cors",
            });

            if (!response.ok) {
              throw new Error(`Lead capture request failed with status ${response.status}`);
            }

            form.hidden = true;
            if (confirmation) {
              confirmation.hidden = false;
            }
          } catch (error) {
            if (fallbackNote) {
              fallbackNote.hidden = false;
              fallbackNote.textContent =
                "Verzenden lukt nu niet. Probeer opnieuw of gebruik de contactpagina voor directe opvolging.";
            }
            if (submitter instanceof HTMLButtonElement) {
              submitter.disabled = false;
            }
          }
        });
      }
    }
  </script>

  <style>
    h1 {
      margin-top: 0;
      font-family: "Merriweather", Georgia, serif;
    }

    h2 {
      margin: 0 0 0.5rem;
      font-family: "Merriweather", Georgia, serif;
      font-size: 1.1rem;
    }

    .lead-magnet {
      display: grid;
      gap: 1rem;
    }

    .magnet-meta {
      background: #f6fbf8;
      border: 1px solid #dbeae2;
      border-radius: 10px;
      padding: 0.85rem;
    }

    .magnet-meta p {
      margin: 0 0 0.45rem;
    }

    .magnet-meta ul {
      margin: 0;
      padding-left: 1.2rem;
    }

    form {
      display: grid;
      gap: 0.9rem;
    }

    label {
      display: grid;
      gap: 0.35rem;
      font-weight: 600;
    }

    input {
      width: 100%;
      border: 1px solid #ccd4cf;
      border-radius: 10px;
      padding: 0.62rem 0.7rem;
      font: inherit;
    }

    .cta-row {
      display: flex;
      gap: 0.65rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-secondary {
      border: 1px solid #ccd4cf;
      background: #fff;
      color: #1f2a2e;
      border-radius: 999px;
      padding: 0.55rem 0.9rem;
      font-weight: 700;
      text-decoration: none;
    }

    .btn:disabled {
      opacity: 0.65;
      cursor: wait;
    }

    .microcopy {
      margin: 0;
      font-size: 0.92rem;
      color: #4b5a52;
    }

    .note {
      margin: 0;
      color: #8a3f00;
      background: #fff7ed;
      border: 1px solid #fed7aa;
      border-radius: 10px;
      padding: 0.75rem;
    }

    .confirmation {
      background: #effcf3;
      border: 1px solid #bfebcc;
      border-radius: 10px;
      padding: 0.85rem;
    }

    .confirmation p {
      margin: 0;
    }
  </style>
</BaseLayout>
